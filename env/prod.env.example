# Стенд prod (удалённый сервер). Настоящие значения только в Jenkins (секретный файл env-prod)
COMPOSE_PROJECT_NAME=task-prod
# Версия образа app, которую разворачиваем (тот же тег, что прошёл stage)
APP_TAG=latest

# Порты: все привязаны к 127.0.0.1 сервера, доступ только через SSH-туннель
APP_PORT=8280
DB_PORT=5532
KAFKA_PORT=9292
KAFKA_UI_PORT=8290
WIREMOCK_PORT=8289

DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=change_me_prod_db_password

APP_SECURITY_USER_PASSWORD=change_me_user_password
APP_SECURITY_ADMIN_PASSWORD=change_me_admin_password
# Случайная строка не короче 32 символов
APP_SECURITY_JWT_SECRET=change_me_long_random_string_at_least_32_chars

# Справочник сотрудников: на prod тоже заглушка WireMock (реального справочника нет)
APP_DIRECTORY_BASEURL=http://wiremock:8080
APP_DIRECTORY_TOKENURL=http://wiremock:8080/oauth/token
APP_DIRECTORY_CLIENTSECRET=stub-secret