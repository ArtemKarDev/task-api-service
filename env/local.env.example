# Стенд local: приложение запускается из IDEA, в Docker поднимается только БД.
COMPOSE_PROJECT_NAME=task-local
DB_PORT=5433
APP_PORT=8080
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=local_dev_password
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# Авторизация сервиса (учебные значения для local, как в настройках запуска IDEA)
APP_SECURITY_USER_PASSWORD=local_user_password
APP_SECURITY_ADMIN_PASSWORD=local_admin_password
APP_SECURITY_JWT_SECRET=local-dev-jwt-secret-0123456789abcdef