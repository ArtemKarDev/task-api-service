# Стенд dev. Имя проекта ДОЛЖНО быть task-api-service: так подхватится том с данными.
COMPOSE_PROJECT_NAME=task-api-service
DB_PORT=5432
APP_PORT=8180
DB_NAME=taskdb
DB_USER=taskuser
# Пароль, с которым БД была создана. Для существующей БД менять нельзя.
DB_PASSWORD=local_dev_password
KAFKA_PORT=9192
KAFKA_UI_PORT=8190

# Авторизация сервиса. Настоящие значения только в env-файле и в Jenkins, в Git не попадают.
APP_SECURITY_USER_PASSWORD=change_me_user_password
APP_SECURITY_ADMIN_PASSWORD=change_me_admin_password
# Случайная строка не короче 32 символов
APP_SECURITY_JWT_SECRET=change_me_long_random_string_at_least_32_chars